{
  "name": "@trackr/api",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "dev": "tsx src/dev.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "worker": "node dist/worker.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "dev:api": "tsx watch src/main.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "latest",
    "@aws-sdk/s3-request-presigner": "latest",
    "@bull-board/api": "latest",
    "@bull-board/express": "latest",
    "@nestjs/common": "latest",
    "@nestjs/core": "latest",
    "@nestjs/jwt": "latest",
    "@nestjs/passport": "latest",
    "@nestjs/platform-express": "latest",
    "@nestjs/platform-socket.io": "latest",
    "@nestjs/swagger": "latest",
    "@nestjs/websockets": "latest",
    "@opentelemetry/api": "latest",
    "@opentelemetry/auto-instrumentations-node": "latest",
    "@opentelemetry/exporter-trace-otlp-http": "latest",
    "@opentelemetry/sdk-node": "latest",
    "@react-email/components": "latest",
    "@react-email/render": "latest",
    "@sentry/node": "latest",
    "@socket.io/redis-adapter": "latest",
    "@socket.io/redis-emitter": "latest",
    "@trackr/shared": "workspace:*",
    "argon2": "latest",
    "bullmq": "latest",
    "cookie-parser": "latest",
    "dotenv": "latest",
    "drizzle-orm": "latest",
    "express": "^5.2.1",
    "helmet": "latest",
    "ioredis": "latest",
    "nestjs-pino": "latest",
    "nodemailer": "latest",
    "passport": "latest",
    "passport-google-oauth20": "latest",
    "passport-jwt": "latest",
    "pdf-parse": "latest",
    "pg": "latest",
    "pino-http": "latest",
    "react": "latest",
    "reflect-metadata": "latest",
    "resend": "latest",
    "rxjs": "latest",
    "socket.io": "latest",
    "stripe": "latest"
  },
  "devDependencies": {
    "@electric-sql/pglite": "latest",
    "@electric-sql/pglite-pgvector": "^0.0.9",
    "@nestjs/testing": "latest",
    "@trackr/config": "workspace:*",
    "@types/cookie-parser": "latest",
    "@types/express": "latest",
    "@types/node": "latest",
    "@types/nodemailer": "latest",
    "@types/passport-google-oauth20": "latest",
    "@types/passport-jwt": "latest",
    "@types/pg": "latest",
    "@types/react": "latest",
    "@types/supertest": "latest",
    "drizzle-kit": "latest",
    "supertest": "latest",
    "tsx": "latest"
  }
}
