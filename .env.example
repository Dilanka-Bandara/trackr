# Copy to .env. Replace all development secrets before deployment.
NODE_ENV=development
PORT=4000
# Number of trusted reverse-proxy hops; 0 locally, 1 behind Caddy/ALB.
TRUST_PROXY_HOPS=0
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api
# PostgreSQL 16 credentials and connection string
POSTGRES_USER=trackr
POSTGRES_PASSWORD=trackr-local-only
POSTGRES_DB=trackr
POSTGRES_PORT=5432
DATABASE_URL=postgresql://trackr:trackr-local-only@localhost:5432/trackr
REDIS_URL=redis://localhost:6379
# At least 32 characters each; generate with a cryptographically secure generator
JWT_SECRET=change-me-local-jwt-secret-at-least-32-characters
AI_INTERNAL_KEY=change-me-local-ai-secret-at-least-32-characters
AI_URL=http://localhost:8000
# Must match the provider output dimensions AND schema migration
EMBEDDING_DIM=1024
# S3-compatible storage. Public endpoint is used for browser upload signatures.
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=trackr-uploads
S3_ACCESS_KEY=trackr-local
S3_SECRET_KEY=trackr-local-secret
# AI providers: openai or bedrock; no AI result is fabricated when keys are absent
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
# Optional Google OAuth; callback is API_URL/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional Stripe test-mode keys, monthly recurring Price ID, and webhook signing secret
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# Mailpit locally, Resend in production
EMAIL_PROVIDER=smtp
EMAIL_FROM=Trackr <hello@trackr.local>
SMTP_HOST=localhost
SMTP_PORT=1025
RESEND_API_KEY=
# Optional observability; empty disables exports
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
# Seed-only admin credential; demo account is disabled by the seed script in production
SEED_ADMIN_EMAIL=admin@trackr.dev
SEED_ADMIN_PASSWORD=
# Production Compose image registry, immutable image tag, and domain
REGISTRY=ghcr.io/your-github-user/trackr
IMAGE_TAG=latest
DOMAIN=localhost
# Backup destination (AWS CLI credentials are supplied by the host role)
BACKUP_S3_URI=
